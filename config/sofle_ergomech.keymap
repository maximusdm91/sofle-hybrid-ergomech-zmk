#define ZMK_POINTING_DEFAULT_SCRL_VAL 300

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base_layer {
            label = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&mt GRAVE ESCAPE            &kp N1    &kp N2    &kp N3  &kp N4       &kp N5       &kp N6      &kp N7     &kp N8        &kp N9    &kp N0     &studio_unlock
&kp TAB                     &kp Q     &kp W     &kp E   &kp R        &kp T        &kp Y       &kp U      &kp I         &kp O     &kp P      &kp BSPC
&kp LEFT_SHIFT              &kp A     &kp S     &kp D   &kp F        &kp G        &kp H       &kp J      &kp K         &kp L     &kp SEMI   &kp SQT
&mt LEFT_CONTROL BACKSPACE  &kp Z     &kp X     &kp C   &kp V        &kp B        &kp N       &kp M      &kp COMMA     &kp DOT   &kp FSLH   &kp RSHFT
&kp K_MUTE                  &kp LGUI  &kp LALT  &mo 3   &lt 2 SPACE  &lt 1 ENTER  &kp SPACE   &kp LEFT   &kp UP_ARROW  &kp DOWN  &kp RIGHT
                                                                                  &caps_word  &kp RIGHT  &kp UP        &kp LEFT  &kp DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        second_layer {
            label = "2nd ";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans       &kp NUMBER_6  &kp N7  &kp N8     &kp N9      &kp N0         &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&bootloader  &kp Y         &kp U   &kp I      &kp O       &kp P          &bt BT_CLR      &bt BT_NXT    &bt BT_PRV    &trans        &trans        &bootloader
&trans       &kp H         &kp J   &kp K      &kp L       &kp SEMICOLON  &trans          &trans        &trans        &trans        &trans        &trans
&trans       &kp N         &kp M   &kp COMMA  &kp PERIOD  &kp SLASH      &kp LBKT        &kp RBKT      &kp SEMI      &kp COLON     &kp BSLH      &trans
&trans       &trans        &trans  &trans     &trans      &trans         &trans          &trans        &trans        &trans        &trans
                                                                         &caps_word      &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        third_layer {
            label = "3rd";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans  &kp CARET         &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans     &trans    &trans    &trans     &trans   &trans
&trans  &kp MINUS         &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH          &kp PG_UP  &trans    &kp UP    &trans     &trans   &trans
&trans  &kp UNDERSCORE    &kp PLUS       &kp LEFT_BRACE    &kp RBRC              &kp PIPE               &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans  &kp SINGLE_QUOTE  &kp DQT        &trans            &trans                &trans                 &trans     &trans    &trans    &trans     &trans   &trans
&trans  &trans            &trans         &trans            &trans                &trans                 &trans     &trans    &trans    &trans     &trans
                                                                                                        &trans     &trans    &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        fourth_layer {
            bindings = <
&kp F1  &kp F2    &kp F3    &kp F4     &kp F5   &kp F6   &kp F6  &kp F7      &kp F8           &kp F9      &kp F10      &kp F11
&kp F7  &kp F8    &kp UP    &kp F9     &kp F10  &kp F11  &trans  &kp INS     &kp PRINTSCREEN  &kp C_MENU  &trans       &kp F12
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &kp F12  &trans  &kp K_UNDO  &kp K_CUT        &kp K_COPY  &kp K_PASTE  &trans
&trans  &trans    &trans    &trans     &trans   &trans   &trans  &trans      &trans           &trans      &trans       &trans
&trans  &trans    &trans    &trans     &trans   &trans   &trans  &trans      &trans           &trans      &trans
                                                         &trans  &trans      &trans           &trans      &trans
            >;

            label = "4th";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "RGB";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &trans  &trans  &trans  &trans  &trans  &trans
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &trans  &trans  &trans  &trans  &trans  &trans
&trans             &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans           &trans           &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans           &trans           &trans           &trans           &trans           &trans  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_TOG    &trans           &trans           &trans           &trans           &trans           &trans  &trans  &trans  &trans  &trans
                                                                                                        &kp A   &kp B   &kp C   &kp D   &kp E
            >;
        };
    };
};
